<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>FellAndSellMod</AssemblyName>
    <RootNamespace>FellAndSell.Mod</RootNamespace>
    <Description>Korean language patch scaffold for Fell &amp; Sell.</Description>
  </PropertyGroup>
  <ItemGroup>
    <!-- Download only the official package; runtime dependencies are provided by the installed loader. -->
    <PackageDownload Include="LavaGang.MelonLoader" Version="[0.7.3]" />
    <Reference Include="MelonLoader">
      <HintPath>$(NuGetPackageRoot)lavagang.melonloader/0.7.3/lib/net6.0/MelonLoader.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
